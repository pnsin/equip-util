# Streamlit Cloud: 앱 → Settings → Secrets 에 아래 내용을 붙여 넣으세요.
# (이 파일은 예시입니다. 실제 secrets.toml 은 GitHub에 올리지 마세요.)
# 구글 시트 설정이 없으면 앱은 임시 파일에 저장하며, 사이드바에 경고가 표시됩니다.

# 팀원만 들어오도록 접속 비밀번호 (비워 두면 비밀번호 없이 열림)
app_password = "여기에-팀-비밀번호"

[gsheets]
spreadsheet_id = "스프레드시트 주소의 /d/ 와 /edit 사이 문자열"

[gcp_service_account]
# 서비스 계정 키(JSON 파일)의 항목을 그대로 옮깁니다. 전극 공정 관리 시스템과 같은 계정을 써도 됩니다.
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "서비스계정이름@프로젝트.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
